# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=i686-linux-gnu
pkgname=$_target-zlib
epoch=1
pkgver=1.3.2
pkgrel=1
pkgdesc="Compression library implementing the deflate compression method found in gzip and PKZIP ($_target)"
arch=(any)
url='https://www.zlib.net/'
license=(Zlib)
depends=("$_target-glibc")
makedepends=("$_target-gcc" "$_target-environment")
options=(!buildflags !strip staticlibs !emptydirs)
source=(https://github.com/madler/zlib/releases/download/v$pkgver/zlib-$pkgver.tar.xz{,.asc})
sha256sums=('d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3'
            'SKIP')
validpgpkeys=('5ED46A6721D365587791E2AA783FCD8E58BCAFBA') # Mark Adler <madler@alumni.caltech.edu>

build() {
  cd zlib-$pkgver
  . /usr/bin/$_target-env

  CHOST=$_target ./configure \
    --prefix=/usr/$_target \
    --libdir=/usr/$_target/lib \
    --includedir=/usr/$_target/include
  make
}

package() {
  cd zlib-$pkgver
  make DESTDIR="$pkgdir" install
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a
  $_target-strip --strip-unneeded "$pkgdir"/usr/$_target/lib/libz.so.$pkgver
  install -Dm644 LICENSE "$pkgdir/usr/$_target/share/licenses/$pkgname/LICENSE"
  rm -rf "$pkgdir"/usr/$_target/share/man
}

