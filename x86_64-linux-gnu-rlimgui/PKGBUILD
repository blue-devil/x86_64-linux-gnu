# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-rlimgui
pkgver=6.0
_tag=Raylib_6_0
pkgrel=2
pkgdesc="Dear ImGui backend for raylib, as a static library ($_target)"
arch=(any)
url='https://github.com/raylib-extras/rlImGui'
license=(Zlib)
depends=("$_target-imgui" "$_target-raylib")
makedepends=("$_target-gcc" "$_target-pkg-config")
options=(!buildflags staticlibs !strip)
source=("rlImGui-$_tag.tar.gz::https://github.com/raylib-extras/rlImGui/archive/refs/tags/$_tag.tar.gz"
        rlimgui-cmdlists-size.patch)
sha256sums=('2d2385f42595ca1f5fd10434c1d34b4392994ba28105454ab88bc808a9bafd33'
            '68220325e5cb693382aefd06e05e754475c0fb88852f31b383d4babad1fefbe4')

prepare() {
  cd "rlImGui-$_tag"
  patch -p1 -i "$srcdir/rlimgui-cmdlists-size.patch"
}

build() {
  cd "rlImGui-$_tag"
  $_target-g++ -O2 -fPIC -std=c++17 -I. $($_target-pkg-config --cflags imgui raylib) \
    -c rlImGui.cpp -o "$srcdir/rlImGui.o"
  $_target-ar rcs "$srcdir/librlImGui.a" "$srcdir/rlImGui.o"
}

package() {
  cd "rlImGui-$_tag"
  local _prefix="$pkgdir/usr/$_target"
  install -d "$_prefix/include/extras" "$_prefix/lib/pkgconfig"
  install -m644 rlImGui.h rlImGuiColors.h imgui_impl_raylib.h "$_prefix/include/"
  install -m644 extras/IconsFontAwesome6.h extras/FA6FreeSolidFontData.h "$_prefix/include/extras/"
  install -m644 "$srcdir/librlImGui.a" "$_prefix/lib/"
  $_target-strip --strip-debug "$_prefix/lib/librlImGui.a"
  cat > "$_prefix/lib/pkgconfig/rlImGui.pc" <<EOF
prefix=/usr/$_target
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: rlImGui
Description: Dear ImGui backend for raylib (static)
Version: $pkgver
Requires: imgui raylib
Cflags: -I\${includedir}
Libs: -L\${libdir} -lrlImGui
EOF
  install -Dm644 LICENSE "$pkgdir/usr/$_target/share/licenses/$pkgname/LICENSE"
  install -Dm644 extras/FontAwsome_LICENSE.txt "$pkgdir/usr/$_target/share/licenses/$pkgname/FontAwesome_LICENSE.txt"
}

# vim: ts=2 sw=2 et:
