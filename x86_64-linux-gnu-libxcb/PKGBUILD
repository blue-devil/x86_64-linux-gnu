# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-libxcb
pkgver=1.17.0
pkgrel=1
pkgdesc="X11 client-side library ($_target)"
arch=(any)
url='https://xorg.freedesktop.org/'
license=(MIT)
depends=("x86_64-linux-gnu-xcb-proto" "x86_64-linux-gnu-libxau" "x86_64-linux-gnu-libxdmcp" "x86_64-linux-gnu-glibc")
makedepends=("$_target-gcc" "$_target-environment" "$_target-configure" "$_target-pkg-config" python)
options=(!buildflags !strip staticlibs !emptydirs)
source=(https://xorg.freedesktop.org/releases/individual/lib/libxcb-$pkgver.tar.xz)
sha256sums=('599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55')

build() {
  cd libxcb-$pkgver
  . /usr/bin/$_target-env
  ./configure \
    --build=$CHOST \
    --host=$_target \
    --prefix=/usr/$_target \
    --libdir=/usr/$_target/lib \
    --enable-static \
    --disable-silent-rules \
    --disable-devel-docs \
    --without-doxygen
  make
}

package() {
  cd libxcb-$pkgver
  make DESTDIR="$pkgdir" install
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a
  find "$pkgdir"/usr/$_target/lib -name '*.so.*.*.*' -exec $_target-strip --strip-unneeded '{}' +
  rm -f "$pkgdir"/usr/$_target/lib/*.la
  rm -rf "$pkgdir"/usr/$_target/share/{man,doc}
  install -Dm644 COPYING* -t "$pkgdir/usr/$_target/share/licenses/$pkgname/"
}

# vim: ts=2 sw=2 et:
