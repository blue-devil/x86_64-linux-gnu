# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-fontconfig
pkgver=2.18.3
pkgrel=1
pkgdesc="Library for configuring and customizing font access ($_target)"
arch=(any)
url='https://www.freedesktop.org/wiki/Software/fontconfig/'
license=(HPND)
depends=("$_target-expat" "$_target-freetype2")
makedepends=(meson ninja gperf python "$_target-environment" "$_target-pkg-config")
options=(!buildflags !strip staticlibs !emptydirs)
source=("fontconfig-$pkgver.tar.gz::https://gitlab.freedesktop.org/fontconfig/fontconfig/-/archive/$pkgver/fontconfig-$pkgver.tar.gz")
sha256sums=('9ae01e1d53acdef56010c5451cd34aa41d325b2faccd8606448d8fa01b2496b3')

build() {
  . /usr/bin/$_target-env
  meson setup build fontconfig-$pkgver \
    --cross-file /usr/share/$_target/meson-$_target.ini \
    --prefix=/usr/$_target \
    --libdir=lib \
    --buildtype=plain \
    -D tools=disabled \
    -D tests=disabled \
    -D doc=disabled \
    -D nls=disabled \
    -D cache-build=disabled \
    -D xml-backend=expat \
    -D default_library=both
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a 2>/dev/null || true
  find "$pkgdir"/usr/$_target/lib -name '*.so.*.*.*' -exec $_target-strip --strip-unneeded '{}' +
  rm -rf "$pkgdir"/usr/$_target/share/{man,doc,gettext}
  install -Dm644 fontconfig-$pkgver/COPYING -t "$pkgdir/usr/$_target/share/licenses/$pkgname/"
}

# vim: ts=2 sw=2 et:
