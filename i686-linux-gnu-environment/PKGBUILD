# Maintainer: xantares
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=i686-linux-gnu
pkgname=$_target-environment
pkgver=1
pkgrel=2
pkgdesc="Script providing common environment variables for the $_target cross toolchain"
arch=(any)
url='https://fedoraproject.org/wiki/MinGW'
license=(BSD-2-Clause)
depends=("$_target-gcc" "$_target-pkg-config")
optdepends=('qemu-user: run target binaries during meson and cmake checks')
source=(linux-env.sh
        meson-linux.ini)
sha256sums=('42dcbc982063a119dd2e5e4a609abfc039c93fb0f386ce1d02e24be611c14163'
            'f48ae9952c407a21d9363d30448ab1eac0230dc3190610af38c75eb3bdb5b8a0')

build() {
  sed "s|@TRIPLE@|$_target|g" linux-env.sh > $_target-env
  sed "s|@TRIPLE@|$_target|g;s|@CPU_FAMILY@|x86|g;s|@CPU@|i686|g;s|@QEMU@|qemu-i386|g" meson-linux.ini > meson-$_target.ini
}

package() {
  install -Dm755 $_target-env "$pkgdir/usr/bin/$_target-env"
  install -Dm644 meson-$_target.ini "$pkgdir/usr/share/$_target/meson-$_target.ini"
}

