# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-libglvnd
pkgver=1.7.0
pkgrel=1
pkgdesc="The GL Vendor-Neutral Dispatch library ($_target)"
arch=(any)
url='https://xorg.freedesktop.org/'
license=(MIT)
depends=("x86_64-linux-gnu-libx11" "x86_64-linux-gnu-libxext" "x86_64-linux-gnu-glibc")
makedepends=("$_target-gcc" "$_target-environment" "$_target-configure" "$_target-pkg-config" meson ninja)
options=(!buildflags !strip staticlibs !emptydirs)
source=(libglvnd-v$pkgver.tar.gz::https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$pkgver/libglvnd-v$pkgver.tar.gz)
sha256sums=('2b6e15b06aafb4c0b6e2348124808cbd9b291c647299eaaba2e3202f51ff2f3d')

build() {
  . /usr/bin/$_target-env
  meson setup build libglvnd-v$pkgver \
    --cross-file /usr/share/$_target/meson-$_target.ini \
    --prefix=/usr/$_target \
    --libdir=lib \
    --buildtype=plain \
    -D gles1=false \
    -D gles2=false \
    -D tls=true
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a 2>/dev/null || true
  $_target-strip --strip-unneeded "$pkgdir"/usr/$_target/lib/*.so* 2>/dev/null || true
  install -Dm644 libglvnd-v$pkgver/README.md -t "$pkgdir/usr/$_target/share/licenses/$pkgname/"
}

# vim: ts=2 sw=2 et:
