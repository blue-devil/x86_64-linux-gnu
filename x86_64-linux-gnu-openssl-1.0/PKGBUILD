package() {
  cd "$srcdir/openssl-$_ver"

  make INSTALL_PREFIX="$pkgdir" install_sw

  # Move some files around
  install -m755 -d "$pkgdir/usr/${_target}/include/openssl-1.0"
  mv "$pkgdir/usr/${_target}/include/openssl" "$pkgdir/usr/${_target}/include/openssl-1.0/"
  mv "$pkgdir/usr/${_target}/lib/openssl-1.0/libcrypto.so.1.0.0" "$pkgdir/usr/${_target}/lib/"
  mv "$pkgdir/usr/${_target}/lib/openssl-1.0/libssl.so.1.0.0" "$pkgdir/usr/${_target}/lib/"
  ln -sf ../libssl.so.1.0.0 "$pkgdir/usr/${_target}/lib/openssl-1.0/libssl.so"
  ln -sf ../libcrypto.so.1.0.0 "$pkgdir/usr/${_target}/lib/openssl-1.0/libcrypto.so"
  mv "$pkgdir/usr/${_target}/bin/openssl" "$pkgdir/usr/${_target}/bin/openssl-1.0"

  # Update includedir in .pc files
  sed -e 's|/include$|/include/openssl-1.0|' -i "$pkgdir"/usr/${_target}/lib/openssl-1.0/pkgconfig/*.pc

  rm -rf "$pkgdir"/{etc,usr/bin/c_rehash}

  install -D -m644 LICENSE "$pkgdir/usr/${_target}/share/licenses/${pkgname}/LICENSE"
}

