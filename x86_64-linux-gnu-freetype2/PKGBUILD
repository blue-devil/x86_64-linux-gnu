# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-freetype2
pkgver=2.14.3
pkgrel=1
pkgdesc="Font rasterization library ($_target)"
arch=(any)
url='https://www.freetype.org/'
license=(FTL OR GPL-2.0-or-later)
depends=("$_target-zlib" "$_target-libpng")
makedepends=(meson ninja "$_target-environment" "$_target-pkg-config")
options=(!buildflags !strip staticlibs !emptydirs)
source=(https://download.savannah.gnu.org/releases/freetype/freetype-$pkgver.tar.xz)
sha256sums=('36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f')

build() {
  . /usr/bin/$_target-env
  meson setup build freetype-$pkgver \
    --cross-file /usr/share/$_target/meson-$_target.ini \
    --prefix=/usr/$_target \
    --libdir=lib \
    --buildtype=plain \
    -D zlib=system \
    -D png=enabled \
    -D brotli=disabled \
    -D bzip2=disabled \
    -D harfbuzz=disabled \
    -D tests=disabled \
    -D default_library=both
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a 2>/dev/null || true
  find "$pkgdir"/usr/$_target/lib -name '*.so.*.*.*' -exec $_target-strip --strip-unneeded '{}' +
  rm -rf "$pkgdir"/usr/$_target/share/man
  install -Dm644 freetype-$pkgver/LICENSE.TXT freetype-$pkgver/docs/FTL.TXT freetype-$pkgver/docs/GPLv2.TXT -t "$pkgdir/usr/$_target/share/licenses/$pkgname/"
}

