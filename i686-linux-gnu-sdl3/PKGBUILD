# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=i686-linux-gnu
pkgname=$_target-sdl3
pkgver=3.4.16
pkgrel=1
pkgdesc="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 3) ($_target)"
arch=(any)
url='https://libsdl.org'
license=(Zlib)
depends=("$_target-libx11" "$_target-libxext" "$_target-libxcursor" "$_target-libxi" "$_target-libxfixes"
         "$_target-libxrandr" "$_target-libglvnd" "$_target-alsa-lib")
makedepends=(ninja "$_target-cmake")
options=(!debug !buildflags !strip staticlibs)
source=(https://github.com/libsdl-org/SDL/releases/download/release-$pkgver/SDL3-$pkgver.tar.gz{,.sig})
sha256sums=('7322236cd12090c3eb40b9728be4d49c76f66ad17d04369584d4ecad5cf77c68'
            'SKIP')
validpgpkeys=('0900104363B4C9D4223DE149D913FE7D4B61D39B'
              '1528635D8053A57F77D1E08630A59377A7763BE6') # Sam Lantinga <slouken@libsdl.org>

_opts=(
  -D CMAKE_INSTALL_PREFIX=/usr/$_target
  -D CMAKE_BUILD_TYPE=None
  -D SDL_TESTS=OFF
  -D SDL_HIDAPI=OFF
  -D SDL_X11=ON
  -D SDL_X11_SHARED=ON
  -D SDL_X11_XSCRNSAVER=OFF
  -D SDL_X11_XTEST=OFF
  -D SDL_ALSA=ON
  -D SDL_ALSA_SHARED=ON
  -D SDL_WAYLAND=OFF
  -D SDL_PULSEAUDIO=OFF
  -D SDL_PIPEWIRE=OFF
  -D SDL_JACK=OFF
  -D SDL_SNDIO=OFF
  -D SDL_KMSDRM=OFF
  -D SDL_LIBUDEV=OFF
  -D SDL_DBUS=OFF
  -D SDL_IBUS=OFF
)

build() {
  $_target-cmake -S SDL3-$pkgver -B build-static -G Ninja -D BUILD_SHARED_LIBS=OFF "${_opts[@]}"
  $_target-cmake -S SDL3-$pkgver -B build-shared -G Ninja -D BUILD_SHARED_LIBS=ON "${_opts[@]}"
  cmake --build build-static
  cmake --build build-shared
}

package() {
  DESTDIR="$pkgdir" cmake --install build-static
  DESTDIR="$pkgdir" cmake --install build-shared
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a
  find "$pkgdir"/usr/$_target/lib -name '*.so.*.*.*' -exec $_target-strip --strip-unneeded '{}' +
  install -Dm644 SDL3-$pkgver/LICENSE.txt "$pkgdir/usr/$_target/share/licenses/$pkgname/LICENSE"
}

