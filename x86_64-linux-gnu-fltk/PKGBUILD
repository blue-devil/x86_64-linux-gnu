# Maintainer: Emanuele Giacomelli <manu-archlinux@altmails.com>
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-fltk
pkgver=1.3.11
pkgrel=1
pkgdesc="Graphical user interface toolkit ($_target)"
arch=(any)
url='https://www.fltk.org/'
license=('LGPL-2.0-only WITH FLTK-exception')
depends=("$_target-libjpeg-turbo" "$_target-libpng" "$_target-zlib" "$_target-libxft" "$_target-libx11" "$_target-libxext"
         "$_target-libxcursor" "$_target-libxinerama" "$_target-libxfixes" "$_target-libxrender" "$_target-libglvnd" "$_target-glu" bash)
makedepends=("$_target-configure")
options=(!docs !strip !buildflags staticlibs)
source=("https://github.com/fltk/fltk/releases/download/release-$pkgver/fltk-$pkgver-source.tar.gz"
        subdirs.patch)
sha256sums=('92805abc84505e3e7e27aec775ab0754ecb4182fe2d8ff2a9d568ccdcb2811ac'
            '42969ffc180257ab6301c241a3b0a8e605e5420e7b6b8a434e821479491badf9')

prepare() {
  cd fltk-$pkgver
  patch -p1 -i ../subdirs.patch
}

build() {
  cp -a fltk-$pkgver build
  cd build
  $_target-configure --prefix=/usr/$_target --enable-threads --enable-shared --enable-xft \
    --disable-localjpeg --disable-localzlib --disable-localpng .
  make
}

package() {
  cd build
  make DESTDIR="$pkgdir" install
  chmod 0644 "$pkgdir"/usr/$_target/lib/*.a
  install -d "$pkgdir/usr/bin"
  ln -sf "../$_target/bin/fltk-config" "$pkgdir/usr/bin/$_target-fltk-config"
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a
  find "$pkgdir"/usr/$_target/lib -name '*.so.*' -type f -exec $_target-strip --strip-unneeded '{}' +
  rm -rf "$pkgdir"/usr/$_target/share/man "$pkgdir"/usr/$_target/share/doc
  install -Dm644 COPYING "$pkgdir/usr/$_target/share/licenses/$pkgname/COPYING"
}

# vim: ts=2 sw=2 et:
