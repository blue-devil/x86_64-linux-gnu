# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=i686-linux-gnu
pkgname=$_target-imgui
pkgver=1.92.9
pkgrel=3
pkgdesc="Bloat-free immediate mode GUI for C++ with GLFW, SDL2, SDL3, OpenGL 2 and OpenGL 3 backends as static libraries ($_target)"
arch=(any)
url='https://github.com/ocornut/imgui'
license=(MIT)
depends=("$_target-libglvnd" "$_target-glfw" "$_target-sdl2" "$_target-sdl3")
makedepends=("$_target-gcc" "$_target-pkg-config")
options=(!buildflags staticlibs !strip)
source=("imgui-$pkgver.tar.gz::https://github.com/ocornut/imgui/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('af97ed649182c39314320514a672b82008ab462b9293fe23d37b30bfa5d05519')

_core=(imgui.cpp imgui_demo.cpp imgui_draw.cpp imgui_tables.cpp imgui_widgets.cpp misc/cpp/imgui_stdlib.cpp)
_backends=(opengl2 opengl3 glfw sdl2 sdlrenderer2 sdl3 sdlrenderer3)

_backend_pc() {
  case $1 in
    glfw) echo glfw3 ;;
    sdl2|sdlrenderer2) echo sdl2 ;;
    sdl3|sdlrenderer3) echo sdl3 ;;
  esac
}

build() {
  cd "imgui-$pkgver"
  local _flags=(-O2 -fPIC -std=c++17 -I. -Ibackends)
  local _objs=()
  mkdir -p "$srcdir/out"
  for _src in "${_core[@]}"; do
    $_target-g++ "${_flags[@]}" -c "$_src" -o "$srcdir/out/$(basename "${_src%.cpp}").o"
    _objs+=("$srcdir/out/$(basename "${_src%.cpp}").o")
  done
  $_target-ar rcs "$srcdir/out/libimgui.a" "${_objs[@]}"
  for _b in "${_backends[@]}"; do
    local _extra=()
    [[ -n $(_backend_pc $_b) ]] && _extra=($($_target-pkg-config --cflags $(_backend_pc $_b)))
    $_target-g++ "${_flags[@]}" "${_extra[@]}" -c "backends/imgui_impl_$_b.cpp" -o "$srcdir/out/imgui_impl_$_b.o"
    $_target-ar rcs "$srcdir/out/libimgui_impl_$_b.a" "$srcdir/out/imgui_impl_$_b.o"
  done
}

package() {
  cd "imgui-$pkgver"
  local _prefix="$pkgdir/usr/$_target"
  local _inc="$_prefix/include/imgui"
  install -d "$_inc/backends" "$_inc/misc/cpp" "$_prefix/lib/pkgconfig"
  install -m644 imgui.h imconfig.h imgui_internal.h imstb_rectpack.h imstb_textedit.h imstb_truetype.h "$_inc/"
  install -m644 misc/cpp/imgui_stdlib.h "$_inc/misc/cpp/"
  for _b in "${_backends[@]}"; do
    install -m644 "backends/imgui_impl_$_b.h" "$_inc/backends/"
  done
  install -m644 backends/imgui_impl_opengl3_loader.h "$_inc/backends/"
  install -m644 "$srcdir"/out/*.a "$_prefix/lib/"
  $_target-strip --strip-debug "$_prefix"/lib/libimgui*.a

  cat > "$_prefix/lib/pkgconfig/imgui.pc" <<EOF
prefix=/usr/$_target
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: imgui
Description: Dear ImGui, immediate mode GUI for C++ (core, static)
Version: $pkgver
Cflags: -I\${includedir}/imgui -I\${includedir}/imgui/backends
Libs: -L\${libdir} -limgui
EOF
  for _b in "${_backends[@]}"; do
    case $_b in
      opengl2) _req="imgui gl" _libs="-limgui_impl_opengl2" ;;
      opengl3) _req="imgui" _libs="-limgui_impl_opengl3 -ldl" ;;
      *) _req="imgui $(_backend_pc $_b)" _libs="-limgui_impl_$_b" ;;
    esac
    cat > "$_prefix/lib/pkgconfig/imgui_impl_$_b.pc" <<EOF
prefix=/usr/$_target
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: imgui_impl_$_b
Description: Dear ImGui $_b backend (static)
Version: $pkgver
Requires: $_req
Cflags: -I\${includedir}/imgui/backends
Libs: -L\${libdir} $_libs
EOF
  done
  install -Dm644 LICENSE.txt "$pkgdir/usr/$_target/share/licenses/$pkgname/LICENSE.txt"
}

