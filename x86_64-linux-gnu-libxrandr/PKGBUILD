# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=x86_64-linux-gnu
pkgname=$_target-libxrandr
pkgver=1.5.5
pkgrel=1
pkgdesc="X11 RandR extension library ($_target)"
arch=(any)
url='https://xorg.freedesktop.org/'
license=(MIT)
depends=("x86_64-linux-gnu-libxext" "x86_64-linux-gnu-libxrender" "x86_64-linux-gnu-glibc")
makedepends=("$_target-gcc" "$_target-environment" "$_target-configure" "$_target-pkg-config")
options=(!buildflags !strip staticlibs !emptydirs)
source=(https://xorg.freedesktop.org/releases/individual/lib/libXrandr-$pkgver.tar.xz)
sha256sums=('72b922c2e765434e9e9f0960148070bd4504b288263e2868a4ccce1b7cf2767a')

build() {
  cd libXrandr-$pkgver
  . /usr/bin/$_target-env
  ./configure \
    --build=$CHOST \
    --host=$_target \
    --prefix=/usr/$_target \
    --libdir=/usr/$_target/lib \
    --enable-static \
    --disable-silent-rules \
    --disable-malloc0returnsnull
  make
}

package() {
  cd libXrandr-$pkgver
  make DESTDIR="$pkgdir" install
  $_target-strip --strip-debug "$pkgdir"/usr/$_target/lib/*.a
  find "$pkgdir"/usr/$_target/lib -name '*.so.*.*.*' -exec $_target-strip --strip-unneeded '{}' +
  rm -f "$pkgdir"/usr/$_target/lib/*.la
  rm -rf "$pkgdir"/usr/$_target/share/{man,doc}
  install -Dm644 COPYING* -t "$pkgdir/usr/$_target/share/licenses/$pkgname/"
}

# vim: ts=2 sw=2 et:
